# Bitiq Lab Environment Configuration

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth (username/password via Supabase Auth + profiles table — see AUTH_SETUP.md)
AUTH_REQUIRED=true
ALLOW_PUBLIC_SIGNUP=false
AUTH_BOOTSTRAP_SECRET=

# ============================================
# Anthropic (Claude API)
# ============================================
ANTHROPIC_API_KEY=sk-ant-xxx

# ============================================
# Binance API (Testnet for Paper Trading)
# ============================================
BINANCE_TESTNET_API_KEY=your_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret
BINANCE_API_KEY=your_mainnet_api_key  # For future live trading
BINANCE_API_SECRET=your_mainnet_api_secret

# ============================================
# TradingView MCP Configuration
# ============================================
TRADINGVIEW_MCP_URL=http://localhost:3000
TRADINGVIEW_MCP_API_KEY=your_mcp_api_key

# Stage 1C — in-container Chromium for tradingview-mcp (Railway).
# CDP is loopback-only. Do not publish 9222. Do not put TradingView passwords here.
TRADINGVIEW_BROWSER_ENABLED=true
TRADINGVIEW_BROWSER_HEADLESS=true
TRADINGVIEW_BROWSER_USER_DATA_DIR=/data/tradingview-profile
TRADINGVIEW_BROWSER_STARTUP_TIMEOUT_MS=30000
TRADINGVIEW_BROWSER_URL=https://www.tradingview.com/chart/
# TRADINGVIEW_BROWSER_EXECUTABLE=/usr/bin/chromium
CDP_HOST=127.0.0.1
CDP_PORT=9222

# Stage 1 candidate webhook (TradingView cannot set arbitrary HMAC headers).
# Shared secret goes in the webhook URL query string AND the Pine JSON body.
TRADINGVIEW_WEBHOOK_TOKEN=change-me-long-random-token
# Optional public URL used when generating Pine / alert instructions.
# TRADINGVIEW_CANDIDATE_WEBHOOK_URL=https://your-backend.example.com

# ============================================
# Stage 2 enrichment providers (optional)
# ============================================
# CoinGlass: heatmap / taker overlay / exchange flows. If unset → UNAVAILABLE_PLAN.
# COINGLASS_API_KEY=
# CoinAPI: orderbook/quotes overlay. If unset, Binance public REST fills market.
# COINAPI_KEY=
# ALPHA_VANTAGE_API_KEY=  # economic calendar (existing)
# COINMARKETCAP_API_KEY=  # fear & greed (existing)

# Freshness TTLs (ms). Defaults: market 30s, OI 2m, funding 5m, liq 2m, macro 30m, F&G 24h.
# ENRICHMENT_TTL_MARKET_MS=30000
# ENRICHMENT_TTL_ORDERBOOK_MS=30000
# ENRICHMENT_TTL_OI_MS=120000
# ENRICHMENT_TTL_FUNDING_MS=300000
# ENRICHMENT_TTL_LIQUIDATIONS_MS=120000
# ENRICHMENT_TTL_TAKER_MS=120000
# ENRICHMENT_TTL_TAKER_FLOW_MS=120000
# ENRICHMENT_TTL_MACRO_MS=1800000
# ENRICHMENT_TTL_SENTIMENT_MS=86400000
# ENRICHMENT_HTTP_TIMEOUT_MS=8000
# ENRICHMENT_HTTP_MAX_RETRIES=2

# Stage 2B enrichment worker (dedicated Railway service: npm run worker:enrichment)
# ENRICHMENT_WORKER_POLL_MS=5000
# ENRICHMENT_WORKER_BATCH_SIZE=3
# ENRICHMENT_WORKER_CONCURRENCY=1
# ENRICHMENT_MAX_ATTEMPTS=5
# ENRICHMENT_RETRY_BASE_MS=5000
# ENRICHMENT_RETRY_MAX_MS=900000
# ENRICHMENT_STALE_LOCK_MS=300000
# ENRICHMENT_WORKER_ID=enrichment-railway-1
# ENRICHMENT_WORKER_SECRET=change-me-internal-tick-secret
# ENRICHMENT_WORKER_HTTP=true

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Features & Flags
# ============================================
ENABLE_AUTO_RESEARCH=true
# Phase 4A: paper session creation gate (default true when unset). Set false to refuse new sessions.
ENABLE_PAPER_TRADING=true
# Phase 4A hard rule: live trading stays false. Server refuses live orders regardless.
ENABLE_LIVE_TRADING=false

# ============================================
# Backtest Engine Configuration
# ============================================
BACKTEST_ENGINE_WORKERS=4  # Number of parallel backtest workers
BACKTEST_ENGINE_TIMEOUT=600000  # 10 minutes

# ============================================
# Paper Trading Configuration
# ============================================
PAPER_TRADING_INITIAL_CAPITAL=10000
PAPER_TRADING_USE_TESTNET=true
PAPER_TRADING_MIN_DAYS=14
PAPER_TRADING_MIN_TRADES=30

# ============================================
# LLM Configuration
# ============================================
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=info
ENABLE_SENTRY=false
SENTRY_DSN=

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/bitiqlab

# ============================================
# Redis (optional, for caching)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Development Settings
# ============================================
NEXT_PUBLIC_DEBUG=false
VERBOSE_LOGGING=false
NEXT_PUBLIC_ALLOW_SIGNUP=false
